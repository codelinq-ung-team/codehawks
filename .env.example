# Names of the settings the API reads. Placeholders only: never put a real value in this file.
#
# The backend reads environment variables, not .env files. Copy this to .env (ignored by Git),
# fill it in, and load it into your shell before starting the API:
#   set -a; . ./.env; set +a
# Deployed settings come from CloudFormation and Secrets Manager; see apps/backend/README.md.
# Without any of these the API still starts, and the website uses its labeled scripted fallback.

# --- Model (Amazon Bedrock) ---
# Uses your AWS CLI credentials; there is no model key. Ask Israel before making live calls.
MODEL_ID=amazon.nova-pro-v1:0
AWS_REGION=us-east-1

# --- Plaid Sandbox (optional: the "connect accounts" shortcut on the Basics form) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# PLAID_CLIENT_NAME=LincLife

# --- Voice (optional: the Quest app's spoken conversation) ---
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=

# --- Set by the stack on Lambda; leave unset locally ---
# Locally, pairing sessions live in the API process and the call limit is off.
# CHAT_RATE_LIMIT_TABLE=
# PAIRING_TABLE=
# PLAID_CREDENTIALS_SECRET=
# OPENAI_API_KEY_SECRET=

# Copy to backend/.env for local use. Existing server environment variables take precedence.
GROQ_API_KEY=replace-with-your-private-groq-api-key
# Optional overrides; these are the defaults:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY is also supported and takes precedence over GROQ_API_KEY.
PORT=8000

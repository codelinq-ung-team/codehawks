# Local development only; use a model authorized by the account owner.
# Existing environment variables take precedence. No API keys are used.
MODEL_ID=replace-with-authorized-bedrock-model-or-profile-id
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=your-short-lived-credentials-profile
PORT=8000

# Plaid Sandbox only. Keep real values in backend/.env; never commit that file.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-sandbox-secret
PLAID_CLIENT_NAME=LinqLife

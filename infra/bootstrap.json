{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Disposable codelinq hackathon GitHub OIDC access. Independent of Codehawks production.",
  "Parameters": {
    "GitHubOidcProviderArn": {
      "Type": "String",
      "Default": "arn:aws:iam::394270749442:oidc-provider/token.actions.githubusercontent.com",
      "AllowedValues": [
        "arn:aws:iam::394270749442:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
    "BootstrapRevision": {
      "Type": "String",
      "Default": "1",
      "Description": "Updated by each GitHub Actions bootstrap deployment.",
      "AllowedPattern": "^[0-9]{1,12}$"
    },
    "GitHubOrganization": {
      "Type": "String",
      "Default": "codelinq-ung-team",
      "Description": "GitHub organization slug.",
      "AllowedValues": [
        "codelinq-ung-team"
      ]
    },
    "GitHubOrganizationId": {
      "Type": "String",
      "Default": "337436199",
      "Description": "Immutable GitHub organization ID.",
      "AllowedValues": [
        "337436199"
      ]
    },
    "GitHubRepositoryName": {
      "Type": "String",
      "Default": "codehawks",
      "Description": "GitHub repository name.",
      "AllowedValues": [
        "codehawks"
      ]
    },
    "GitHubRepositoryId": {
      "Type": "String",
      "Default": "1403496059",
      "Description": "Immutable GitHub repository ID.",
      "AllowedValues": [
        "1403496059"
      ]
    }
  },
  "Resources": {
    "ArtifactsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-build-artifacts",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "codelinq-hackathon"
          },
          {
            "Key": "Owner",
            "Value": "Israel Jauregui"
          },
          {
            "Key": "Lifecycle",
            "Value": "ephemeral"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          },
          {
            "Key": "BootstrapRevision",
            "Value": {
              "Ref": "BootstrapRevision"
            }
          }
        ]
      }
    },
    "ArtifactsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ArtifactsBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ArtifactsBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ArtifactsBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "RuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "codelinq-hackathon-runtime-boundary",
        "Description": "Maximum runtime permissions for this disposable hackathon only.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*/*"
              }
            },
            {
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/codelinq-hackathon-app-*:log-stream:*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/codelinq-hackathon/app/*:log-stream:*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchGetItem",
                "dynamodb:BatchWriteItem"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/codelinq-hackathon-app-*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/codelinq-hackathon-app-*/index/*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "sqs:SendMessage",
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:GetQueueAttributes",
                "sqs:GetQueueUrl",
                "sqs:ChangeMessageVisibility"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:codelinq-hackathon-app-*"
              }
            },
            {
              "Effect": "Allow",
              "Action": "lambda:InvokeFunction",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:codelinq-hackathon-app-*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/codelinq-hackathon/app/*"
              }
            },
            {
              "Effect": "Allow",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:codelinq-hackathon-app-*"
              }
            }
          ]
        }
      }
    },
    "CloudFormationRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "codelinq-hackathon-cloudformation",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "hackathon-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:*",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:*",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/codelinq-hackathon-app-*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/codelinq-hackathon-app-*/index/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "logs:*",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/codelinq-hackathon-app-*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/codelinq-hackathon/app/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ecr:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:PutParameter",
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                    "ssm:DeleteParameter",
                    "ssm:AddTagsToResource",
                    "ssm:RemoveTagsFromResource",
                    "ssm:ListTagsForResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/codelinq-hackathon/app/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:CreateRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-app-*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PermissionsBoundary": {
                        "Ref": "RuntimeBoundary"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PutRolePermissionsBoundary",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-app-*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PermissionsBoundary": {
                        "Ref": "RuntimeBoundary"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListRolePolicies",
                    "iam:ListAttachedRolePolicies",
                    "iam:ListRoleTags",
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:DeleteRole",
                    "iam:UpdateAssumeRolePolicy",
                    "iam:UpdateRole",
                    "iam:UpdateRoleDescription",
                    "iam:TagRole",
                    "iam:UntagRole"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-app-*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": [
                        "lambda.amazonaws.com",
                        "ecs-tasks.amazonaws.com"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListRolePolicies",
                    "iam:ListRoleTags",
                    "iam:CreateRole",
                    "iam:DeleteRole",
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:UpdateAssumeRolePolicy",
                    "iam:TagRole",
                    "iam:UntagRole"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-app-*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PermissionsBoundary": {
                        "Ref": "RuntimeBoundary"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateDistribution",
                    "cloudfront:TagResource"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestTag/Project": "codelinq-hackathon",
                      "aws:RequestTag/Lifecycle": "ephemeral"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:GetDistribution",
                    "cloudfront:GetDistributionConfig",
                    "cloudfront:UpdateDistribution",
                    "cloudfront:DeleteDistribution",
                    "cloudfront:TagResource",
                    "cloudfront:UntagResource",
                    "cloudfront:ListTagsForResource",
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation",
                    "cloudfront:ListInvalidations"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "codelinq-hackathon"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:ListOriginAccessControls",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:GetOriginAccessControl",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:CreateConnectionGroup",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestTag/Project": "codelinq-hackathon",
                      "aws:RequestTag/Lifecycle": "ephemeral"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:GetVpcOrigin",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:vpcorigin/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "codelinq-hackathon"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "codelinq-hackathon"
          },
          {
            "Key": "Owner",
            "Value": "Israel Jauregui"
          },
          {
            "Key": "Lifecycle",
            "Value": "ephemeral"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "codelinq-hackathon-github-deploy",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubOrganization}@${GitHubOrganizationId}/${GitHubRepositoryName}@${GitHubRepositoryId}:environment:hackathon"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "hackathon-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/codelinq-hackathon-bootstrap/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:ListStackResources",
                    "cloudformation:GetTemplate",
                    "cloudformation:CreateChangeSet",
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DeleteChangeSet"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/codelinq-hackathon-app/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:ValidateTemplate",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-cloudformation"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket",
                    "s3:ListBucketMultipartUploads"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "acm:RequestCertificate",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "acm:ValidationMethod": "DNS",
                      "aws:RequestTag/Project": "codelinq-hackathon",
                      "aws:RequestTag/Lifecycle": "ephemeral"
                    },
                    "ForAllValues:StringEquals": {
                      "acm:DomainNames": "codelinq.codehawks.org"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "acm:ListCertificates"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "acm:DescribeCertificate",
                    "acm:ListTagsForCertificate"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:acm:us-east-1:${AWS::AccountId}:certificate/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "codelinq-hackathon"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:CreateInvalidation",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "codelinq-hackathon"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "codelinq-hackathon"
          },
          {
            "Key": "Owner",
            "Value": "Israel Jauregui"
          },
          {
            "Key": "Lifecycle",
            "Value": "ephemeral"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "TeardownRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "codelinq-hackathon-github-teardown",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubOrganization}@${GitHubOrganizationId}/${GitHubRepositoryName}@${GitHubRepositoryId}:environment:hackathon-teardown"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "hackathon-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:ListStackResources",
                    "cloudformation:GetTemplate",
                    "cloudformation:DeleteStack"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/codelinq-hackathon-app/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-cloudformation"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:ListBucketVersions",
                    "s3:GetBucketTagging",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:DeleteObject",
                    "s3:DeleteObjectVersion"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-app-*/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:ListImages",
                    "ecr:BatchDeleteImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/codelinq-hackathon-app-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:GetDistribution",
                    "cloudfront:GetDistributionConfig",
                    "cloudfront:UpdateDistribution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "codelinq-hackathon"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "acm:ListCertificates"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "acm:DescribeCertificate",
                    "acm:ListTagsForCertificate",
                    "acm:DeleteCertificate"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:acm:us-east-1:${AWS::AccountId}:certificate/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "codelinq-hackathon"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "codelinq-hackathon"
          },
          {
            "Key": "Owner",
            "Value": "Israel Jauregui"
          },
          {
            "Key": "Lifecycle",
            "Value": "ephemeral"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "BootstrapRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "codelinq-hackathon-github-bootstrap",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubOrganization}@${GitHubOrganizationId}/${GitHubRepositoryName}@${GitHubRepositoryId}:environment:hackathon-admin"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "update-hackathon-bootstrap",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:ListStackResources",
                    "cloudformation:GetTemplate",
                    "cloudformation:UpdateStack",
                    "cloudformation:CreateChangeSet",
                    "cloudformation:ExecuteChangeSet"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/codelinq-hackathon-bootstrap/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeChangeSet",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DeleteChangeSet",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:changeSet/codelinq-hackathon-bootstrap-*/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:ValidateTemplate",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-cloudformation-bootstrap"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "codelinq-hackathon"
          },
          {
            "Key": "Owner",
            "Value": "Israel Jauregui"
          },
          {
            "Key": "Lifecycle",
            "Value": "ephemeral"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "BootstrapCloudFormationRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Retain",
      "Properties": {
        "RoleName": "codelinq-hackathon-cloudformation-bootstrap",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyName": "manage-hackathon-bootstrap",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:CreateRole",
                    "iam:DeleteRole",
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:UpdateAssumeRolePolicy",
                    "iam:UpdateRole",
                    "iam:UpdateRoleDescription",
                    "iam:TagRole",
                    "iam:UntagRole",
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListRolePolicies",
                    "iam:ListAttachedRolePolicies",
                    "iam:ListRoleTags"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-github-*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-cloudformation-bootstrap"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:CreateRole",
                    "iam:DeleteRole",
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:UpdateAssumeRolePolicy",
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListRolePolicies"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/codelinq-hackathon-cloudformation"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetPolicy",
                    "iam:GetPolicyVersion",
                    "iam:ListPolicyVersions",
                    "iam:CreatePolicyVersion",
                    "iam:DeletePolicyVersion",
                    "iam:SetDefaultPolicyVersion",
                    "iam:DeletePolicy",
                    "iam:CreatePolicy"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/codelinq-hackathon-runtime-boundary"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:DeleteObjectVersion",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::codelinq-hackathon-artifacts-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:ListOriginAccessControls",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudfront:CreateOriginAccessControl",
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "codelinq-hackathon"
          },
          {
            "Key": "Owner",
            "Value": "Israel Jauregui"
          },
          {
            "Key": "Lifecycle",
            "Value": "ephemeral"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      },
      "UpdateReplacePolicy": "Retain"
    },
    "CloudFrontOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": "codelinq-hackathon-bootstrap-oac",
          "Description": "Private S3 access for the Codelinq hackathon CloudFront site.",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      },
      "DependsOn": "BootstrapCloudFormationRole",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
    "DeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeployRole",
          "Arn"
        ]
      }
    },
    "TeardownRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "TeardownRole",
          "Arn"
        ]
      }
    },
    "CloudFormationRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "CloudFormationRole",
          "Arn"
        ]
      }
    },
    "RuntimePermissionsBoundaryArn": {
      "Value": {
        "Ref": "RuntimeBoundary"
      }
    },
    "ArtifactsBucketName": {
      "Value": {
        "Ref": "ArtifactsBucket"
      }
    },
    "AccountId": {
      "Value": {
        "Ref": "AWS::AccountId"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "BootstrapRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "BootstrapRole",
          "Arn"
        ]
      }
    },
    "BootstrapCloudFormationRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "BootstrapCloudFormationRole",
          "Arn"
        ]
      }
    },
    "CloudFrontOriginAccessControlId": {
      "Value": {
        "Fn::GetAtt": [
          "CloudFrontOriginAccessControl",
          "Id"
        ]
      }
    }
  }
}

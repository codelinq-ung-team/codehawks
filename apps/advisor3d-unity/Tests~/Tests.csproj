<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for the parts with no Unity types: the calculator, and the chat script. Unity ignores folders ending in ~. Run from advisor3d-unity with "dotnet run", passing this folder as the project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.cs" />
    <Compile Include="../Assets/Scripts/Calculator.cs" />
    <Compile Include="../Assets/Scripts/Store.cs" />
    <Compile Include="../Assets/Scripts/Script.cs" />
    <Compile Include="../Assets/Scripts/VoiceScript.cs" />
    <Compile Include="../Assets/Scripts/Pairing.cs" />
  </ItemGroup>
</Project>
